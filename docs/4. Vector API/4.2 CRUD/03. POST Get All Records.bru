meta {
  name: 03. POST Get All Records
  type: http
  seq: 3
}

post {
  url: {{base_url}}/vector/{{vector_table_name}}/get
  body: json
  auth: inherit
}

body:json {
  {
      "provider": "pgvector",
      "embedding": "source",
      "select": "*"
  }
}

tests {
  test("Status 200", function() { expect(res.status).to.equal(200); });
  test("has value array", function() { expect(res.body.value).to.be.an("array"); });
}
