						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"model_name\": \"meta-llama/Llama-3.1-8B-Instruct\",\n  \"display_name\": \"Llama 3.1 8B (Updated)\",\n  \"device\": \"cuda\",\n  \"access_mode\": \"internal_service\",\n  \"is_required\": true,\n  \"url\": \"http://localhost:8080\",\n  \"api_key\": \"\",\n  \"headers\": {},\n  \"version\": \"3.1.1\",\n  \"status\": \"VALIDATED\",\n  \"capabilities\": {\n    \"chat\": true,\n    \"embeddings\": true\n  },\n  \"config\": {\n    \"max_context\": 8192\n  }\n}",
							"options": {
