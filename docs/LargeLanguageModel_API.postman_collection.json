				},
				{
					"name": "POST Create LLM Model",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"model_name\": \"meta-llama/Llama-3.1-8B-Instruct\",\n  \"display_name\": \"Llama 3.1 8B\",\n  \"device\": \"cuda\",\n  \"access_mode\": \"direct\",\n  \"is_required\": false,\n  \"url\": \"http://localhost:8080\",\n  \"api_key\": \"\",\n  \"headers\": {\n    \"Authorization\": \"Bearer token\"\n  },\n  \"version\": \"3.1\",\n  \"capabilities\": {\n    \"chat\": true,\n    \"embeddings\": false\n  },\n  \"config\": {\n    \"max_context\": 4096\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/llm",
							"host": ["{{base_url}}"],
							"path": ["llm"]
						},
						"description": "Register a new LLM model."
