		{
			"name": "4. Document RAG API",
			"item": [
				{
					"name": "4.1 Collections",
					"item": [
						{
							"name": "POST Create Collection",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"name\": \"my-collection\",\n  \"description\": \"A collection for storing knowledge base documents\",\n  \"model\": \"gte-base\",\n  \"chunk_length\": 512,\n  \"chunk_overlap\": 50,\n  \"provider\": \"Pgvector\",\n  \"vector_search\": {\n    \"algorithms\": [\n      {\n        \"name\": \"my_hnsw\",\n        \"kind\": \"hnsw\",\n        \"hnsw_parameters\": {\n          \"m\": 16,\n          \"ef_construction\": 200,\n          \"ef_search\": 100,\n          \"metric\": \"cosine\"\n        }\n      }\n    ],\n    \"profiles\": [\n      {\n        \"name\": \"default_profile\",\n        \"algorithm\": \"my_hnsw\"\n      }\n    ]\n  }\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{base_url}}/document/collection",
									"host": ["{{base_url}}"],
									"path": ["document", "collection"]
								},
								"description": "Create a new document collection."
							}
						},
						{
							"name": "GET List Collections",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{base_url}}/document/collection?page=1&pageSize=20",
									"host": ["{{base_url}}"],
									"path": ["document", "collection"],
									"query": [
										{
											"key": "page",
											"value": "1",
											"description": "Page number"
										},
										{
											"key": "pageSize",
											"value": "20",
											"description": "Page size"
										}
									]
								},
								"description": "Get list of collections (paginated)."
							}
						},
						{
							"name": "GET Collection Details",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{base_url}}/document/collection/{{collection_name}}",
									"host": ["{{base_url}}"],
									"path": ["document", "collection", "{{collection_name}}"]
								},
								"description": "Get collection details with document and chunk counts."
							}
						},
						{
							"name": "PUT Update Collection",
							"request": {
								"method": "PUT",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"description\": \"Updated collection description\",\n  \"chunk_length\": 1024,\n  \"chunk_overlap\": 100\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{base_url}}/document/collection/{{collection_name}}",
									"host": ["{{base_url}}"],
									"path": ["document", "collection", "{{collection_name}}"]
								},
								"description": "Update a collection."
							}
						},
						{
							"name": "DELETE Collection",
							"request": {
								"method": "DELETE",
								"header": [],
								"url": {
									"raw": "{{base_url}}/document/collection/{{collection_name}}",
									"host": ["{{base_url}}"],
									"path": ["document", "collection", "{{collection_name}}"]
								},
								"description": "Delete a collection with all documents and chunks."
							}
						}
					]
				},
				{
					"name": "4.2 Documents",
					"item": [
						{
							"name": "POST Create Document",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"title\": \"Getting Started Guide\",\n  \"content\": \"This is the full text content of the document that will be chunked and embedded automatically.\",\n  \"source\": \"https://docs.example.com/getting-started\",\n  \"tags\": [\"guide\", \"onboarding\"],\n  \"metadata\": {\n    \"author\": \"John Doe\",\n    \"category\": \"documentation\"\n  },\n  \"chunk_length\": 512,\n  \"chunk_overlap\": 50\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{base_url}}/document/{{collection_name}}/documents",
									"host": ["{{base_url}}"],
									"path": ["document", "{{collection_name}}", "documents"]
								},
								"description": "Create a document in a collection. Automatically chunks and generates embeddings."
							}
						},
						{
							"name": "GET List Documents",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{base_url}}/document/{{collection_name}}/documents?page=1&pageSize=20&search=&tags=&sortBy=created_at&sortOrder=desc",
									"host": ["{{base_url}}"],
									"path": ["document", "{{collection_name}}", "documents"],
									"query": [
										{
											"key": "page",
											"value": "1"
										},
										{
											"key": "pageSize",
											"value": "20"
										},
										{
											"key": "search",
											"value": "",
											"description": "Search by title"
										},
										{
											"key": "tags",
											"value": "",
											"description": "Filter by tags (comma-separated)"
										},
										{
											"key": "sortBy",
											"value": "created_at",
											"description": "Sort field"
										},
										{
											"key": "sortOrder",
											"value": "desc",
											"description": "Sort direction: asc or desc"
										}
									]
								},
								"description": "Get list of documents in a collection."
							}
						},
						{
							"name": "POST Batch Create Documents",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"documents\": [\n    {\n      \"title\": \"Document 1\",\n      \"content\": \"Content of the first document.\",\n      \"source\": \"source-1\",\n      \"tags\": [\"batch\", \"test\"],\n      \"metadata\": {}\n    },\n    {\n      \"title\": \"Document 2\",\n      \"content\": \"Content of the second document.\",\n      \"source\": \"source-2\",\n      \"tags\": [\"batch\"],\n      \"metadata\": {}\n    }\n  ],\n  \"chunk_length\": 512,\n  \"chunk_overlap\": 50\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{base_url}}/document/{{collection_name}}/documents/batch",
									"host": ["{{base_url}}"],
									"path": ["document", "{{collection_name}}", "documents", "batch"]
								},
								"description": "Batch create multiple documents at once."
							}
						},
						{
							"name": "POST Upload Document File",
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "formdata",
									"formdata": [
										{
											"key": "file",
											"type": "file",
											"src": "",
											"description": "Document file to upload"
										},
										{
											"key": "title",
											"value": "Uploaded Document",
											"type": "text",
											"description": "Document title (defaults to filename)"
										},
										{
											"key": "tags",
											"value": "[\"uploaded\", \"file\"]",
											"type": "text",
											"description": "Tags (JSON string)"
										},
										{
											"key": "metadata",
											"value": "{\"source_type\": \"file_upload\"}",
											"type": "text",
											"description": "Metadata (JSON string)"
										},
										{
											"key": "chunk_length",
											"value": "512",
											"type": "text",
											"description": "Chunk length"
										},
										{
											"key": "chunk_overlap",
											"value": "50",
											"type": "text",
											"description": "Chunk overlap"
										}
									]
								},
								"url": {
									"raw": "{{base_url}}/document/{{collection_name}}/documents/upload",
									"host": ["{{base_url}}"],
									"path": ["document", "{{collection_name}}", "documents", "upload"]
								},
								"description": "Upload a document from a file."
							}
						},
						{
							"name": "GET Document Details",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{base_url}}/document/{{collection_name}}/documents/{{document_id}}",
									"host": ["{{base_url}}"],
									"path": ["document", "{{collection_name}}", "documents", "{{document_id}}"]
								},
								"description": "Get document details with chunks."
							}
						},
						{
							"name": "PUT Update Document",
							"request": {
								"method": "PUT",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"title\": \"Updated Document Title\",\n  \"content\": \"Updated content - chunks and embeddings will be regenerated.\",\n  \"source\": \"https://docs.example.com/updated\",\n  \"tags\": [\"updated\", \"v2\"],\n  \"metadata\": {\n    \"version\": 2\n  },\n  \"chunk_length\": 1024,\n  \"chunk_overlap\": 100\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{base_url}}/document/{{collection_name}}/documents/{{document_id}}",
									"host": ["{{base_url}}"],
									"path": ["document", "{{collection_name}}", "documents", "{{document_id}}"]
								},
								"description": "Update a document. Regenerates chunks and embeddings if content changed."
							}
						},
						{
							"name": "DELETE Document",
							"request": {
								"method": "DELETE",
								"header": [],
								"url": {
									"raw": "{{base_url}}/document/{{collection_name}}/documents/{{document_id}}",
									"host": ["{{base_url}}"],
									"path": ["document", "{{collection_name}}", "documents", "{{document_id}}"]
								},
								"description": "Delete a document with all its chunks."
							}
						}
					]
				},
				{
					"name": "4.3 Chunks",
					"item": [
						{
							"name": "GET List Chunks",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{base_url}}/document/{{collection_name}}/documents/{{document_id}}/chunks",
									"host": ["{{base_url}}"],
									"path": ["document", "{{collection_name}}", "documents", "{{document_id}}", "chunks"]
								},
								"description": "Get all chunks of a document."
							}
						},
						{
							"name": "POST Create Chunk",
							"request": {
								"method": "POST",
								"header": [
									{
