							"raw": "{{base_url}}/llm?status=VALIDATED&modelName=",
							"host": ["{{base_url}}"],
							"path": ["llm"],
							"query": [
								{
									"key": "status",
									"value": "VALIDATED",
									"description": "Filter by status: DRAFT, VALIDATED, DISABLED"
								},
								{
									"key": "modelName",
									"value": "",
									"description": "Filter by model name"
								}
							]
						},
						"description": "Get list of registered LLM models (tenant-scoped)."
					}
				},
				{
					"name": "GET LLM Model by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
