	"item": [
		{
			"name": "1. Chat API",
			"item": [
				{
					"name": "POST Chat Completions",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"model\": \"meta-llama/Llama-3.1-8B-Instruct\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a helpful assistant.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Hello, how are you?\"\n    }\n  ],\n  \"stream\": false,\n  \"tag\": null,\n  \"stream_interval\": 0.1,\n  \"diversity_penalty\": 0.0,\n  \"do_sample\": true,\n  \"early_stopping\": false,\n  \"length_penalty\": 1.0,\n  \"max_tokens\": 1024,\n  \"min_length\": 0,\n  \"no_repeat_ngram_size\": 0,\n  \"num_beams\": 1,\n  \"num_return_sequences\": 1,\n  \"past_present_share_buffer\": false,\n  \"repetition_penalty\": 1.0,\n  \"temperature\": 0.7,\n  \"top_k\": 50,\n  \"top_p\": 0.9\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/chat/completions",
							"host": ["{{base_url}}"],
							"path": ["chat", "completions"]
						},
						"description": "Generate chat model response (chat completions). Supports streaming."
					}
				},
				{
					"name": "POST Chat Completions (Streaming)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"model\": \"meta-llama/Llama-3.1-8B-Instruct\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Explain quantum computing in simple terms.\"\n    }\n  ],\n  \"stream\": true,\n  \"max_tokens\": 512,\n  \"temperature\": 0.7,\n  \"top_p\": 0.9\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/chat/completions",
							"host": ["{{base_url}}"],
							"path": ["chat", "completions"]
						},
						"description": "Generate chat model response with SSE streaming enabled."
					}
				}
			]
		},
		{
			"name": "2. Embeddings API",
			"item": [
				{
					"name": "POST Generate Embeddings",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"model\": \"gte-base\",\n  \"input\": \"Your text string goes here\",\n  \"chunk_length\": 512\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/embeddings",
							"host": ["{{base_url}}"],
							"path": ["embeddings"]
						},
						"description": "Generate embeddings for input text."
					}
				},
				{
					"name": "POST Generate Embeddings (Array input)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"model\": \"gte-base\",\n  \"input\": [\n    \"First text to embed\",\n    \"Second text to embed\"\n  ],\n  \"chunk_length\": 512\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/embeddings",
							"host": ["{{base_url}}"],
							"path": ["embeddings"]
						},
						"description": "Generate embeddings for an array of texts."
					}
				}
			]
		},
		{
			"name": "3. LLM Registry API",
			"item": [
