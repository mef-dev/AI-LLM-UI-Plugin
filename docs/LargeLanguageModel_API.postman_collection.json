						"body": {
							"mode": "raw",
							"raw": "{\n  \"provider\": \"Pgvector\",\n  \"name\": \"my_vectors\",\n  \"fields\": [\n    {\n      \"name\": \"id\",\n      \"type\": \"bigint\",\n      \"key\": true,\n      \"auto_increment\": true\n    },\n    {\n      \"name\": \"content\",\n      \"type\": \"text\"\n    },\n    {\n      \"name\": \"metadata\",\n      \"type\": \"jsonb\"\n    },\n    {\n      \"name\": \"embedding\",\n      \"type\": \"vector\",\n      \"dimensions\": 768,\n      \"vector_search_profile\": \"default_profile\"\n    }\n  ],\n  \"vector_search\": {\n    \"algorithms\": [\n      {\n        \"name\": \"my_hnsw\",\n        \"kind\": \"hnsw\",\n        \"hnsw_parameters\": {\n          \"m\": 16,\n          \"ef_construction\": 200,\n          \"ef_search\": 100,\n          \"metric\": \"cosine\"\n        }\n      }\n    ],\n    \"profiles\": [\n      {\n        \"name\": \"default_profile\",\n        \"algorithm\": \"my_hnsw\"\n      }\n    ]\n  }\n}",
