{
  "name": "hello-platform-plugin",
  "version": "0.1.2",
  "pluginMefName": "hello-platform-plugin",
  "scripts": {
    "start": "ng serve",
    "generate-version-file": "npx generate-version-file",
    "publish": "npx mef-dev-publish",
    "build:plugin": "npm run generate-version-file && ng build --configuration production --output-hashing none --single-bundle",
    "publish-kuber": "npm run publish apiUrl=https://api.mef.dev debug=true updateConfiguration=true"
  },
  "private": true,
  "dependencies": {
    
        "@angular/animations": "^20.3.18",
        "@angular/cdk": "^20.2.14",
        "@angular/common": "^20.3.18",
        "@angular/compiler": "^20.3.18",
        "@angular/core": "^20.3.18",
        "@angular/forms": "^20.3.18",
        "@angular/platform-browser": "^20.3.18",
        "@angular/platform-browser-dynamic": "^20.3.18",
        "@angular/router": "^20.3.18",
        "@natec/mef-dev-platform-connector": "^17.0.5",
        "@natec/mef-dev-ui-kit": "^20.1.27",
        "bootstrap": "^5.3.8",
        "font-awesome": "^4.7.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "zone.js": "^0.15.1"
  },
  "devDependencies": {
    
        "@angular-devkit/build-angular": "^20.3.18",
        "@angular/cli": "^20.3.18",
        "@angular/compiler-cli": "^20.3.18",
        "@types/jasmine": "~4.3.0",
        "jasmine-core": "~4.6.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "typescript": "^5.9.2"
  }
}
